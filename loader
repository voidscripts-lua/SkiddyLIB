        -- AddBind ─────────────────────────────────────────────────────────
        function Tab:AddBind(bCfg)
            bCfg = bCfg or {}
            local key = bCfg.Default or Enum.KeyCode.Unknown
            local hold = bCfg.Hold or false
            local held, listening = false, false
            local f = baseFrame(28)

            local lbl = Instance.new("TextLabel", f)
            lbl.Size = UDim2.new(0,200,1,0); lbl.Position = UDim2.new(0,8,0,0)
            lbl.BackgroundTransparency = 1; lbl.Text = bCfg.Name or "Keybind"
            lbl.TextColor3 = Color3.fromRGB(255,255,255); lbl.TextSize = 10
            lbl.Font = Enum.Font.Montserrat; lbl.TextXAlignment = Enum.TextXAlignment.Left

            local keyBtn = Instance.new("TextButton", f)
            keyBtn.Size = UDim2.new(0,70,0,20); keyBtn.Position = UDim2.new(1,-76,0.5,-10)
            keyBtn.BackgroundColor3 = Color3.fromRGB(50,50,50)
            keyBtn.BackgroundTransparency = 0.5
            keyBtn.TextColor3 = Color3.fromRGB(255,255,255); keyBtn.TextSize = 9
            keyBtn.Font = Enum.Font.Montserrat; keyBtn.Text = key.Name or "NONE"
            corner(keyBtn, UDim.new(0,4))

            keyBtn.MouseButton1Click:Connect(function()
                listening = true; keyBtn.Text = "..."
            end)
            UserInputService.InputBegan:Connect(function(inp, gp)
                if listening and inp.UserInputType == Enum.UserInputType.Keyboard then
                    key = inp.KeyCode; keyBtn.Text = key.Name; listening = false
                    if bCfg.Flag then SkiddyLib.Flags[bCfg.Flag] = {Value = key} end
                    return
                end
                if gp then return end
                if inp.KeyCode == key then
                    if hold then held = true; if bCfg.Callback then pcall(bCfg.Callback, true) end
                    else if bCfg.Callback then pcall(bCfg.Callback) end end
                end
            end)
            UserInputService.InputEnded:Connect(function(inp)
                if hold and inp.KeyCode == key and held then
                    held = false; if bCfg.Callback then pcall(bCfg.Callback, false) end
                end
            end)

            if bCfg.Flag then SkiddyLib.Flags[bCfg.Flag] = {Value = key} end
            local obj = {}
            function obj:Set(k)
                key = k; keyBtn.Text = k.Name
                if bCfg.Flag then SkiddyLib.Flags[bCfg.Flag] = {Value = key} end
            end
            return obj
        end

        -- AddColorpicker ──────────────────────────────────────────────────
        function Tab:AddColorpicker(cpCfg)
            cpCfg = cpCfg or {}
            local color = cpCfg.Default or Color3.fromRGB(255,255,255)
            local open  = false
            local h, s, v2 = Color3.toHSV(color)

            local wrapper = Instance.new("Frame", page)
            wrapper.Name = rnd(); wrapper.Size = UDim2.new(1,-6,0,28)
            wrapper.BackgroundTransparency = 1; wrapper.LayoutOrder = nextOrder()

            local row = Instance.new("Frame", wrapper)
            row.Size = UDim2.new(1,0,0,28)
            row.BackgroundColor3 = Color3.fromRGB(255,255,255)
            row.BackgroundTransparency = 0.9
            corner(row, UDim.new(0,6))

            local lbl = Instance.new("TextLabel", row)
            lbl.Size = UDim2.new(1,-50,1,0); lbl.Position = UDim2.new(0,8,0,0)
            lbl.BackgroundTransparency = 1; lbl.Text = cpCfg.Name or "Color"
            lbl.TextColor3 = Color3.fromRGB(255,255,255); lbl.TextSize = 10
            lbl.Font = Enum.Font.Montserrat; lbl.TextXAlignment = Enum.TextXAlignment.Left

            local swatch = Instance.new("TextButton", row)
            swatch.Size = UDim2.new(0,24,0,18); swatch.Position = UDim2.new(1,-30,0.5,-9)
            swatch.BackgroundColor3 = color; swatch.Text = ""
            swatch.BorderSizePixel = 0
            corner(swatch, UDim.new(0,4))
            stroke(swatch, Color3.fromRGB(255,255,255), 0.5, 0.7)

            local panel = Instance.new("Frame", wrapper)
            panel.Size = UDim2.new(1,0,0,100); panel.Position = UDim2.new(0,0,0,30)
            panel.BackgroundColor3 = Color3.fromRGB(30,30,30)
            panel.BackgroundTransparency = 0.1; panel.Visible = false
            corner(panel, UDim.new(0,6))

            local hueBar = Instance.new("ImageLabel", panel)
            hueBar.Size = UDim2.new(1,-16,0,10); hueBar.Position = UDim2.new(0,8,0,8)
            hueBar.BackgroundColor3 = Color3.fromRGB(255,255,255)
            hueBar.Image = "rbxassetid://698052001"
            corner(hueBar, UDim.new(0,4))

            local svBox = Instance.new("ImageLabel", panel)
            svBox.Size = UDim2.new(1,-16,0,60); svBox.Position = UDim2.new(0,8,0,26)
            svBox.BackgroundColor3 = Color3.fromHSV(h,1,1)
            svBox.Image = "rbxassetid://2615689005"
            corner(svBox, UDim.new(0,4))

            local rgbLbl = Instance.new("TextLabel", panel)
            rgbLbl.Size = UDim2.new(1,-16,0,10); rgbLbl.Position = UDim2.new(0,8,0,90)
            rgbLbl.BackgroundTransparency = 1; rgbLbl.TextColor3 = Color3.fromRGB(200,200,200)
            rgbLbl.TextSize = 8; rgbLbl.Font = Enum.Font.Montserrat
            rgbLbl.TextXAlignment = Enum.TextXAlignment.Left

            local function updateColor()
                color = Color3.fromHSV(h,s,v2)
                swatch.BackgroundColor3 = color
                svBox.BackgroundColor3  = Color3.fromHSV(h,1,1)
                rgbLbl.Text = string.format("R:%d G:%d B:%d",
                    math.floor(color.R*255), math.floor(color.G*255), math.floor(color.B*255))
                if cpCfg.Callback then pcall(cpCfg.Callback, color) end
                if cpCfg.Flag then SkiddyLib.Flags[cpCfg.Flag] = {Value = color} end
            end
            updateColor()

            local function pct(bar, inp, axis)
                return math.clamp(
                    (inp.Position[axis] - bar.AbsolutePosition[axis]) / bar.AbsoluteSize[axis], 0, 1)
            end

            local dH, dSV = false, false
            hueBar.InputBegan:Connect(function(inp)
                if inp.UserInputType==Enum.UserInputType.MouseButton1
                or inp.UserInputType==Enum.UserInputType.Touch then
                    dH=true; h=pct(hueBar,inp,"X"); updateColor() end
            end)
            svBox.InputBegan:Connect(function(inp)
                if inp.UserInputType==Enum.UserInputType.MouseButton1
                or inp.UserInputType==Enum.UserInputType.Touch then
                    dSV=true; s=pct(svBox,inp,"X"); v2=1-pct(svBox,inp,"Y"); updateColor() end
            end)
            UserInputService.InputChanged:Connect(function(inp)
                if inp.UserInputType~=Enum.UserInputType.MouseMovement
                and inp.UserInputType~=Enum.UserInputType.Touch then return end
                if dH then h=pct(hueBar,inp,"X"); updateColor()
                elseif dSV then s=pct(svBox,inp,"X"); v2=1-pct(svBox,inp,"Y"); updateColor() end
            end)
            UserInputService.InputEnded:Connect(function(inp)
                if inp.UserInputType==Enum.UserInputType.MouseButton1
                or inp.UserInputType==Enum.UserInputType.Touch then dH=false; dSV=false end
            end)

            swatch.MouseButton1Click:Connect(function()
                open = not open; panel.Visible = open
                wrapper.Size = UDim2.new(1,-6,0, open and 132 or 28)
            end)

            if cpCfg.Flag then SkiddyLib.Flags[cpCfg.Flag] = {Value = color} end
            local obj = {}
            function obj:Set(c)
                color = c; h,s,v2 = Color3.toHSV(c); updateColor()
            end
            return obj
        end

        return Tab
    end -- MakeTab

    return Window
