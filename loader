        -- AddDropdown (tbl8.D) ────────────────────────────────────────────
        function Tab:AddDropdown(dCfg)
            dCfg = dCfg or {}
            local opts = dCfg.Options or {}
            local val  = dCfg.Default or (opts[1] or "")
            local open = false

            local wrapper = Instance.new("Frame", page)
            wrapper.Name              = rnd()
            wrapper.Size              = UDim2.new(1, -6, 0, 28)
            wrapper.BackgroundTransparency = 1
            wrapper.LayoutOrder       = nextOrder()

            local mainBtn = Instance.new("TextButton", wrapper)
            mainBtn.Size              = UDim2.new(1, 0, 0, 28)
            mainBtn.BackgroundColor3  = Color3.fromRGB(255, 255, 255)
            mainBtn.BackgroundTransparency = 0.9
            mainBtn.Text              = ""
            corner(mainBtn, UDim.new(0, 6))
            stroke(mainBtn, Color3.fromRGB(255, 255, 255), 0.5, 0.85)

            local lblD = Instance.new("TextLabel", mainBtn)
            lblD.Size               = UDim2.new(1, -30, 1, 0)
            lblD.Position           = UDim2.new(0, 8, 0, 0)
            lblD.BackgroundTransparency = 1
            lblD.Text               = (dCfg.Name or "Dropdown") .. ": " .. tostring(val)
            lblD.TextColor3         = Color3.fromRGB(255, 255, 255)
            lblD.TextSize           = 10
            lblD.Font               = Enum.Font.Montserrat
            lblD.TextXAlignment     = Enum.TextXAlignment.Left

            local arrow = Instance.new("TextLabel", mainBtn)
            arrow.Size              = UDim2.new(0, 20, 1, 0)
            arrow.Position          = UDim2.new(1, -25, 0, 0)
            arrow.BackgroundTransparency = 1
            arrow.Text              = "▼"
            arrow.TextColor3        = Color3.fromRGB(255, 255, 255)
            arrow.TextSize          = 10
            arrow.Font              = Enum.Font.Montserrat

            local listFrame = Instance.new("Frame", wrapper)
            listFrame.Size          = UDim2.new(1, 0, 0, 120)
            listFrame.Position      = UDim2.new(0, 0, 0, 30)
            listFrame.BackgroundTransparency = 1
            listFrame.Visible       = false

            local scroll = Instance.new("ScrollingFrame", listFrame)
            scroll.Size             = UDim2.new(1, 0, 1, 0)
            scroll.BackgroundTransparency = 1
            scroll.BorderSizePixel  = 0
            scroll.ScrollBarThickness = 2
            scroll.AutomaticCanvasSize = Enum.AutomaticSize.Y
            scroll.CanvasSize       = UDim2.new(0, 0, 0, 0)
            local scrollList = listLayout(scroll)
            scrollList.HorizontalAlignment = Enum.HorizontalAlignment.Center
            scrollList.Padding = UDim.new(0, 2)

            local function setVal(v)
                val = v
                lblD.Text = (dCfg.Name or "Dropdown") .. ": " .. tostring(val)
                if dCfg.Callback then pcall(dCfg.Callback, val) end
                if dCfg.Flag then SkiddyLib.Flags[dCfg.Flag] = {Value = val} end
            end

            local function buildList()
                for _, c in ipairs(scroll:GetChildren()) do
                    if c:IsA("TextButton") then c:Destroy() end
                end
                for i, opt in ipairs(opts) do
                    local ob = Instance.new("TextButton", scroll)
                    ob.LayoutOrder = i
                    ob.Size        = UDim2.new(1, -4, 0, 22)
                    ob.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
                    ob.BackgroundTransparency = 0.92
                    ob.Text        = tostring(opt)
                    ob.TextColor3  = Color3.fromRGB(255, 255, 255)
                    ob.TextSize    = 9
                    ob.Font        = Enum.Font.Montserrat
                    corner(ob, UDim.new(0, 4))
                    ob.MouseButton1Click:Connect(function()
                        setVal(opt)
                        open = false
                        listFrame.Visible = false
                        arrow.Text = "▼"
                        wrapper.Size = UDim2.new(1, -6, 0, 28)
                    end)
                end
            end

            mainBtn.MouseButton1Click:Connect(function()
                if not open then buildList() end
                open = not open
                listFrame.Visible = open
                arrow.Text = open and "▲" or "▼"
                wrapper.Size = UDim2.new(1, -6, 0, open and 152 or 28)
            end)

            if dCfg.Flag then SkiddyLib.Flags[dCfg.Flag] = {Value = val} end
            local obj = {}
            function obj:Set(v) setVal(v) end
            function obj:Refresh(list, clear)
                if clear then opts = list
                else for _, v2 in ipairs(list) do table.insert(opts, v2) end end
                local found = false
                for _, v2 in ipairs(opts) do if v2 == val then found = true break end end
                if not found then
                    val = opts[1] or ""
                    lblD.Text = (dCfg.Name or "Dropdown") .. ": " .. tostring(val)
                end
                if open then buildList() end
            end
            function obj:SetOptions(list) obj:Refresh(list, true) end
            return obj
        end

