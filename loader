-- ── image loader (mirrors Skiddy func9 / func10 / func12) ───────────────────────

-- httpGet wrapper — tries game:HttpGet then syn/request
local function httpGet(url)
    local ok, r = pcall(function() return game:HttpGet(url) end)
    if ok and r and #r > 0 then return r end
    local req = probe("request") or probe("http_request")
        or (probe("syn") and probe("syn").request)
    if req then
        ok, r = pcall(function()
            local x = req({Url = url, Method = "GET"})
            return x and x.Body
        end)
        if ok and r and #r > 0 then return r end
    end
    return nil
end

-- fetch URL and cache to disk, return getcustomasset path or nil
local function fetchAndCache(url, fname)
    if not (_writefile and _isfile and _getasset) then return nil end
    local path = "SkiddyHub/" .. fname
    -- ensure folder exists (best-effort)
    pcall(function()
        if not _isfile("SkiddyHub/") then
            local mkf = probe("makefolder")
            if mkf then mkf("SkiddyHub/") end
        end
    end)
    if not _isfile(path) then
        local data = httpGet(url)
        if data then pcall(_writefile, path, data) end
    end
    if _isfile(path) then
        local ok, res = pcall(_getasset, path)
        if ok and res then return res end
    end
    return nil
end

-- resolve an asset key → usable image URL/rbxasset string
-- order: disk cache → postimg → rbx asset → postimg URL raw
local function resolveImage(key)
    -- 1. disk cache via postimg URL
    local r = fetchAndCache(tbl_postimg[key], key)
    if r then return r end
    -- 2. disk cache via rbx URL
    r = fetchAndCache(tbl_rbx[key], key)
    if r then return r end
    -- 3. rbx asset URL directly (no disk)
    if tbl_rbx[key] then return tbl_rbx[key] end
    -- 4. postimg raw
    return tbl_postimg[key]
end

-- async image apply: fires callback(url) once resolved, non-blocking
local function applyImageAsync(key, callback)
    task.spawn(function()
        local url = resolveImage(key)
        if url and callback then
            pcall(callback, url)
        end
    end)
end

-- section texture queue (mirrors Skiddy v41 / tbl3 pattern)
local sectionTexture = nil
local sectionQueue   = {}   -- { imageLabel }

local function applySectionTexture(img)
    sectionTexture = img
    for _, lbl in ipairs(sectionQueue) do
        if lbl and lbl.Parent then
            lbl.Image = img
        end
    end
    sectionQueue = {}
end

local function registerSectionTexture(imageLabel)
    if sectionTexture then
        imageLabel.Image = sectionTexture
    else
        table.insert(sectionQueue, imageLabel)
    end
end

-- start loading tex in background immediately
applyImageAsync("tex", applySectionTexture)

-- ── helpers ───────────────────────────────────────────────────────────────────

local function rnd()
    local s = ""
    for _ = 1, 10 do s = s .. string.char(math.random(97, 122)) end
    return s
end

local function corner(p, r)
    local c = Instance.new("UICorner", p)
    c.CornerRadius = r or UDim.new(0, 8)
    return c
end

local function stroke(p, col, thick, trans)
    local s = Instance.new("UIStroke", p)
    s.Color       = col   or Color3.fromRGB(255, 255, 255)
    s.Thickness   = thick or 1
    s.Transparency= trans or 0.8
    return s
end

local function listLayout(p, dir, pad, ha, va)
    local l = Instance.new("UIListLayout", p)
    l.SortOrder     = Enum.SortOrder.LayoutOrder
    l.FillDirection = dir or Enum.FillDirection.Vertical
    l.Padding       = pad or UDim.new(0, 6)
    if ha then l.HorizontalAlignment = ha end
    if va then l.VerticalAlignment   = va end
    return l
end

local function uiPadding(p, top, bottom, left, right)
    local pad = Instance.new("UIPadding", p)
    pad.PaddingTop    = UDim.new(0, top    or 0)
    pad.PaddingBottom = UDim.new(0, bottom or 0)
    pad.PaddingLeft   = UDim.new(0, left   or 0)
    pad.PaddingRight  = UDim.new(0, right  or 0)
    return pad
end

local function gradient(p, c1, c2, rot)
    local g = Instance.new("UIGradient", p)
    g.Color    = ColorSequence.new(c1, c2)
    g.Rotation = rot or 45
    return g
end

local function tween(obj, t, props)
    local info = TweenInfo.new(
        t,
        Enum.EasingStyle.Quint,
        Enum.EasingDirection.Out
    )
    TweenService:Create(obj, info, props):Play()
end

local function notify(title, text, dur)
    pcall(function()
        game:GetService("StarterGui"):SetCore("SendNotification", {
            Title = title, Text = text, Duration = dur or 3
        })
    end)
end

