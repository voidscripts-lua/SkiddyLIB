function SkiddyLib:MakeNotification(nCfg)
    nCfg = nCfg or {}
    notify(nCfg.Name or nCfg.Title or "SkiddyLib", nCfg.Content or "", nCfg.Time or 3)
end

function SkiddyLib:Init()    end
function SkiddyLib:Destroy() self.Flags = {} end

return SkiddyLib
