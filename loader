-- ── MakeWindow ────────────────────────────────────────────────────────────────

function SkiddyLib:MakeWindow(cfg)
    cfg = cfg or {}
    local winName       = cfg.Name           or "SkiddyLib"
    local closeCallback = cfg.CloseCallback

    -- root
    local folder = Instance.new("Folder")
    folder.Name  = rnd()

    local sg = Instance.new("ScreenGui")
    sg.Name              = rnd()
    sg.ResetOnSpawn      = false
    sg.ZIndexBehavior    = Enum.ZIndexBehavior.Sibling
    sg.DisplayOrder      = 999

    if _protect then pcall(_protect, sg) end
    folder.Parent = (_gethui and pcall(_gethui) and _gethui()) or CoreGui
    sg.Parent     = folder

    -- main frame
    local main = Instance.new("Frame", sg)
    main.Size                 = UDim2.new(0, 540, 0, 300)
    main.Position             = UDim2.new(0.5, -270, 0.5, -150)
    main.BackgroundColor3     = Color3.fromRGB(15, 15, 15)
    main.BackgroundTransparency = 0.1
    main.BorderSizePixel      = 0
    main.Active               = true
    main.Draggable            = true
    main.ClipsDescendants     = true
    corner(main, UDim.new(0, 16))

    -- bg image layer (mirrors Skiddy v17)
    local bgLayer = Instance.new("ImageLabel", main)
    bgLayer.Name               = rnd()
    bgLayer.Size               = UDim2.new(1, -10, 1, -8)
    bgLayer.Position           = UDim2.new(0, 5, 0, 4)
    bgLayer.BackgroundColor3   = cfg.BackgroundColor or Color3.fromRGB(0, 0, 0)
    bgLayer.BackgroundTransparency = cfg.BackgroundImage and 0 or 0
    bgLayer.BorderSizePixel    = 0
    bgLayer.Image              = cfg.BackgroundImage or "" -- custom image supported
    bgLayer.ImageTransparency  = cfg.BackgroundImageTransparency or 0.4
    bgLayer.ScaleType          = Enum.ScaleType.Crop
    corner(bgLayer, UDim.new(0, 14))

    -- gradient fallback — removed once bg image loads
    local bgGrad = gradient(bgLayer,
        Color3.fromRGB(28, 28, 36),
        Color3.fromRGB(14, 14, 20), 60)

    -- Load the default image only when no custom image was supplied.
    if not cfg.BackgroundImage then
        applyImageAsync("bg", function(url)
            if bgLayer and bgLayer.Parent and not cfg.BackgroundImage then
                bgLayer.Image = url
                bgLayer.BackgroundTransparency = 0
                if bgGrad and bgGrad.Parent then bgGrad:Destroy() end
            end
        end)
    elseif bgGrad and bgGrad.Parent then
        bgGrad:Destroy()
    end

    -- title bar row
    local titleRow = Instance.new("Frame", bgLayer)
    titleRow.Name               = rnd()
    titleRow.Size               = UDim2.new(1, -20, 0, 32)
    titleRow.Position           = UDim2.new(0, 10, 0, 8)
    titleRow.BackgroundTransparency = 1
    local trList = listLayout(titleRow, Enum.FillDirection.Horizontal, UDim.new(0, 6))
    trList.VerticalAlignment = Enum.VerticalAlignment.Center

    -- title badge
    local badge = Instance.new("Frame", titleRow)
    badge.LayoutOrder            = 1
    badge.Size                   = UDim2.new(0, 180, 0, 28)
    badge.BackgroundColor3       = Color3.fromRGB(255, 255, 255)
    badge.BackgroundTransparency = 0.9
    corner(badge, UDim.new(0, 8))
    stroke(badge, Color3.fromRGB(255, 255, 255), 1, 0.8)

    -- logo icon (mirrors Skiddy v27 — the small flame/logo inside the badge)
    local badgeIcon = Instance.new("ImageLabel", badge)
    badgeIcon.Name               = rnd()
    badgeIcon.Size               = UDim2.new(0, 22, 0, 22)
    badgeIcon.Position           = UDim2.new(0, 6, 0, 3)
    badgeIcon.BackgroundTransparency = 1
    badgeIcon.Image              = cfg.Icon or ""
    corner(badgeIcon, UDim.new(1, 0))

    -- gradient fallback on icon until logo loads
    local iconGrad = gradient(badgeIcon,
        Color3.fromRGB(255, 160, 80),
        Color3.fromRGB(255, 80, 60))

    if not cfg.Icon or cfg.Icon == "" then
        -- load logo async (mirrors Skiddy func12 logo)
        applyImageAsync("logo", function(url)
            badgeIcon.Image = url
            if iconGrad and iconGrad.Parent then iconGrad:Destroy() end
        end)
    else
        if iconGrad then iconGrad:Destroy() end
    end

    local titleLbl = Instance.new("TextLabel", badge)
    titleLbl.Name               = rnd()
    titleLbl.Size               = UDim2.new(0, 140, 0, 28)
    titleLbl.Position           = UDim2.new(0, 32, 0, 0)
    titleLbl.BackgroundTransparency = 1
    titleLbl.RichText           = true
    titleLbl.Text               = "<b>" .. winName .. "</b>"
    titleLbl.TextColor3         = Color3.fromRGB(255, 255, 255)
    titleLbl.TextSize           = 11
    titleLbl.Font               = Enum.Font.Montserrat
    titleLbl.TextXAlignment     = Enum.TextXAlignment.Left

    -- controls badge
    local controls = Instance.new("Frame", titleRow)
    controls.LayoutOrder            = 2
    controls.Size                   = UDim2.new(0, 65, 0, 28)
    controls.BackgroundColor3       = Color3.fromRGB(255, 255, 255)
    controls.BackgroundTransparency = 0.9
    corner(controls, UDim.new(0, 8))
    stroke(controls, Color3.fromRGB(255, 255, 255), 1, 0.8)
    local cList = listLayout(controls, Enum.FillDirection.Horizontal, UDim.new(0, 2))
    cList.HorizontalAlignment = Enum.HorizontalAlignment.Center
    cList.VerticalAlignment   = Enum.VerticalAlignment.Center

    local btnMin = Instance.new("TextButton", controls)
    btnMin.LayoutOrder = 1
    btnMin.Size        = UDim2.new(0, 28, 1, 0)
    btnMin.BackgroundTransparency = 1
    btnMin.Text        = "−"
    btnMin.TextColor3  = Color3.fromRGB(200, 200, 200)
    btnMin.TextSize    = 18
    btnMin.Font        = Enum.Font.MontserratBold

    local btnClose = Instance.new("TextButton", controls)
    btnClose.LayoutOrder = 2
    btnClose.Size        = UDim2.new(0, 28, 1, 0)
    btnClose.BackgroundTransparency = 1
    btnClose.Text        = "×"
    btnClose.TextColor3  = Color3.fromRGB(255, 80, 80)
    btnClose.TextSize    = 16
    btnClose.Font        = Enum.Font.MontserratBold

    -- content area
    local content = Instance.new("Frame", bgLayer)
    content.Name               = rnd()
    content.Size               = UDim2.new(1, -20, 1, -50)
    content.Position           = UDim2.new(0, 10, 0, 44)
    content.BackgroundTransparency = 1
    listLayout(content, Enum.FillDirection.Horizontal, UDim.new(0, 8))

    -- sidebar
    local sidebar = Instance.new("Frame", content)
    sidebar.LayoutOrder            = 1
    sidebar.Size                   = UDim2.new(0, 130, 1, 0)
    sidebar.BackgroundColor3       = Color3.fromRGB(255, 255, 255)
    sidebar.BackgroundTransparency = 0.9
    corner(sidebar, UDim.new(0, 8))
    stroke(sidebar, Color3.fromRGB(255, 255, 255), 1, 0.8)

    local sideScroll = Instance.new("ScrollingFrame", sidebar)
    sideScroll.Size               = UDim2.new(1, 0, 1, 0)
    sideScroll.BackgroundTransparency = 1
    sideScroll.BorderSizePixel    = 0
    sideScroll.ScrollBarThickness = 2
    sideScroll.AutomaticCanvasSize= Enum.AutomaticSize.Y
    sideScroll.CanvasSize         = UDim2.new(0, 0, 0, 0)
    local sideList = listLayout(sideScroll)
    sideList.HorizontalAlignment = Enum.HorizontalAlignment.Center
    sideList.Padding = UDim.new(0, 4)
    uiPadding(sideScroll, 4)

    -- page host
    local pageHost = Instance.new("Frame", content)
    pageHost.LayoutOrder            = 2
    pageHost.Size                   = UDim2.new(1, -138, 1, 0)
    pageHost.BackgroundColor3       = Color3.fromRGB(255, 255, 255)
    pageHost.BackgroundTransparency = 0.9
    pageHost.ClipsDescendants       = true
    corner(pageHost, UDim.new(0, 8))
    stroke(pageHost, Color3.fromRGB(255, 255, 255), 1, 0.8)

    -- minimise / close
    local minimised = false
    btnMin.MouseButton1Click:Connect(function()
        if minimised then
            tween(main, 0.3, {Size = UDim2.new(0, 540, 0, 300)})
            task.delay(0.15, function() content.Visible = true end)
        else
            content.Visible = false
            tween(main, 0.3, {Size = UDim2.new(0, 540, 0, 48)})
        end
        minimised = not minimised
    end)

    btnClose.MouseButton1Click:Connect(function()
        main.Visible = false
        if closeCallback then pcall(closeCallback) end
    end)

    UserInputService.InputBegan:Connect(function(inp, gp)
        if gp then return end
        if inp.KeyCode == Enum.KeyCode.RightShift then
            main.Visible = not main.Visible
        end
    end)

    -- tab state
    local pages      = {}
    local tabBtns    = {}   -- name → { btn, indicator, nameLbl, icoLbl }
    local pageCount  = 0
    local active     = nil

    -- Soft page transitions + animated active-tab indicator.
    local function activatePage(name)
        if active == name then return end

        local previous = active
        if previous and tabBtns[previous] then
            local old = tabBtns[previous]
            tween(old.btn, 0.24, {BackgroundTransparency = 1})
            tween(old.indicator, 0.24, {
                BackgroundTransparency = 1,
                Size = UDim2.new(0, 3, 0, 0)
            })
            tween(old.nameLbl, 0.22, {
                TextColor3 = Color3.fromRGB(180, 180, 190),
                TextTransparency = 0.18
            })
            if old.icoLbl then
                tween(old.icoLbl, 0.22, {ImageTransparency = 0.38})
            end
        end

        for pageName, pageObject in pairs(pages) do
            if pageName ~= name then
                pageObject.Visible = false
            end
        end

        active = name
        local currentPage = pages[name]
        if currentPage then
            currentPage.Visible = true
            currentPage.Position = UDim2.new(0, 13, 0, 0)
            tween(currentPage, 0.32, {Position = UDim2.new(0, 0, 0, 0)})
        end

        local cur = tabBtns[name]
        if cur then
            tween(cur.btn, 0.26, {BackgroundTransparency = 0.84})
            tween(cur.indicator, 0.30, {
                BackgroundTransparency = 0,
                Size = UDim2.new(0, 3, 0.72, 0)
            })
            tween(cur.nameLbl, 0.26, {
                TextColor3 = Color3.fromRGB(255, 255, 255),
                TextTransparency = 0
            })
            if cur.icoLbl then
                tween(cur.icoLbl, 0.26, {ImageTransparency = 0})
            end
        end
    end

    -- ── Window object ─────────────────────────────────────────────────────

    local Window = {}

    function Window:SetTitle(str)
        titleLbl.Text = "<b>" .. (str or "") .. "</b>"
    end

    function Window:SetIcon(url)
        badgeIcon.Image = url or ""
    end

    -- Background customization:
    -- SetBackground(imageUrl, imageTransparency)
    -- SetBackgroundColor(Color3)
    -- SetBackgroundTransparency(number)
    function Window:SetBackground(imageUrl, imageTransparency)
        cfg.BackgroundImage = imageUrl or ""
        bgLayer.Image = cfg.BackgroundImage
        bgLayer.ImageTransparency = math.clamp(imageTransparency or 0.4, 0, 1)
        if bgGrad and bgGrad.Parent then bgGrad:Destroy() end
    end

    function Window:SetBackgroundColor(color)
        if typeof(color) == "Color3" then
            bgLayer.BackgroundColor3 = color
        end
    end

    function Window:SetBackgroundTransparency(value)
        bgLayer.ImageTransparency = math.clamp(tonumber(value) or 0.4, 0, 1)
    end

    function Window:Notify(nCfg)
        nCfg = nCfg or {}
        notify(nCfg.Name or nCfg.Title or winName, nCfg.Content or "", nCfg.Time or 3)
    end

    function Window:Toggle()
        main.Visible = not main.Visible
    end

    -- ── MakeTab ───────────────────────────────────────────────────────────

    -- maps tab name → Skiddy icon key for auto-assignment
    local autoIconMap = {
        Teleport    = "i_tp",
        Troll       = "i_tr",
        ["Jump Jack"]= "i_jj",
        Animasyonlar= "i_an",
        ["Aim Bot"] = "i_tp",
        Music       = "i_mu",
        Gramer      = "i_an",
        ["Chat Log"]= "i_tr",
        Abuse       = "i_mu",
    }

    function Window:MakeTab(tabCfg)
        tabCfg = tabCfg or {}
        pageCount = pageCount + 1
        local tabName = tabCfg.Name or ("Tab " .. tostring(pageCount))
        local tabIcon = tabCfg.Icon  -- explicit URL; nil = auto-resolve

        -- sidebar button
        local tabBtn = Instance.new("TextButton", sideScroll)
        tabBtn.Name               = rnd()
        tabBtn.Size               = UDim2.new(0, 120, 0, 28)
        tabBtn.BackgroundColor3   = Color3.fromRGB(255, 255, 255)
        tabBtn.BackgroundTransparency = 1
        tabBtn.Text               = ""
        tabBtn.LayoutOrder        = pageCount
        corner(tabBtn, UDim.new(0, 7))
        stroke(tabBtn, Color3.fromRGB(255, 255, 255), 0.6, 1)

        -- slim accent indicator, revealed for the selected tab
        local tabIndicator = Instance.new("Frame", tabBtn)
        tabIndicator.Name = rnd()
        tabIndicator.Size = UDim2.new(0, 3, 0, 0)
        tabIndicator.Position = UDim2.new(0, 0, 0.5, 0)
        tabIndicator.AnchorPoint = Vector2.new(0, 0.5)
        tabIndicator.BackgroundColor3 = cfg.AccentColor or Color3.fromRGB(135, 115, 255)
        tabIndicator.BackgroundTransparency = 1
        tabIndicator.BorderSizePixel = 0
        corner(tabIndicator, UDim.new(1, 0))

        -- icon slot inside button
        local tabIcoLbl = Instance.new("ImageLabel", tabBtn)
        tabIcoLbl.Name               = rnd()
        tabIcoLbl.Size               = UDim2.new(0, 16, 0, 16)
        tabIcoLbl.Position           = UDim2.new(0, 6, 0.5, -8)
        tabIcoLbl.BackgroundTransparency = 1
        tabIcoLbl.Image              = ""

        local tabNameLbl = Instance.new("TextLabel", tabBtn)
        tabNameLbl.Name              = rnd()
        tabNameLbl.Size              = UDim2.new(0, 90, 1, 0)
        tabNameLbl.Position          = UDim2.new(0, 28, 0, 0)
        tabNameLbl.BackgroundTransparency = 1
        tabNameLbl.Text              = tabName
        tabNameLbl.TextColor3        = Color3.fromRGB(255, 255, 255)
        tabNameLbl.TextSize          = 10
        tabNameLbl.Font              = Enum.Font.MontserratMedium
        tabNameLbl.TextXAlignment    = Enum.TextXAlignment.Left
        tabNameLbl.TextColor3        = Color3.fromRGB(180, 180, 190)
        tabNameLbl.TextTransparency  = 0.18

        -- resolve icon: explicit > autoIconMap > nil (no icon)
        if tabIcon and tabIcon ~= "" then
            tabIcoLbl.Image = tabIcon
        else
            local autoKey = autoIconMap[tabName]
            if autoKey then
                applyImageAsync(autoKey, function(url)
                    if tabIcoLbl and tabIcoLbl.Parent then
                        tabIcoLbl.Image = url
                    end
                end)
            else
                -- no icon — shift label to fill full width
                tabNameLbl.Size     = UDim2.new(1, -8, 1, 0)
                tabNameLbl.Position = UDim2.new(0, 4, 0, 0)
                tabNameLbl.TextXAlignment = Enum.TextXAlignment.Center
            end
        end

        -- scrollable page
        local page = Instance.new("ScrollingFrame", pageHost)
        page.Name                  = rnd()
        page.Size                  = UDim2.new(1, 0, 1, 0)
        page.BackgroundTransparency= 1
        page.BorderSizePixel       = 0
        page.ScrollBarThickness    = 3
        page.AutomaticCanvasSize   = Enum.AutomaticSize.Y
        page.CanvasSize            = UDim2.new(0, 0, 0, 0)
        page.Visible               = false
        local pageList = listLayout(page)
        pageList.HorizontalAlignment = Enum.HorizontalAlignment.Center
        pageList.Padding = UDim.new(0, 6)
        uiPadding(page, 6, 6, 6, 6)
        pages[tabName] = page
        tabBtns[tabName] = {
            btn = tabBtn,
            indicator = tabIndicator,
            nameLbl = tabNameLbl,
            icoLbl = tabIcoLbl
        }

        tabBtn.MouseEnter:Connect(function()
            if active ~= tabName then
                tween(tabBtn, 0.16, {BackgroundTransparency = 0.92})
            end
        end)
        tabBtn.MouseLeave:Connect(function()
            if active ~= tabName then
                tween(tabBtn, 0.16, {BackgroundTransparency = 1})
            end
        end)

        page.Position = UDim2.new(0, 13, 0, 0)

        tabBtn.MouseButton1Click:Connect(function()
            activatePage(tabName)
        end)
        if not active then activatePage(tabName) end

        -- ── layout order ──────────────────────────────────────────────────

        local order = 0
        local function nextOrder() order = order + 1 return order end

        -- ── shared frame factory ──────────────────────────────────────────

        local function baseFrame(h)
            local f = Instance.new("Frame", page)
            f.Name               = rnd()
            f.Size               = UDim2.new(1, -6, 0, h)
            f.BackgroundColor3   = Color3.fromRGB(255, 255, 255)
            f.BackgroundTransparency = 0.9
            f.LayoutOrder        = nextOrder()
            corner(f, UDim.new(0, 6))
            return f
        end

        -- ── Tab object ────────────────────────────────────────────────────

        local Tab = {}

        -- AddSection (tbl8.S) ─────────────────────────────────────────────
        function Tab:AddSection(sCfg)
